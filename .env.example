DB_URL=jdbc:postgresql://localhost:5432/live_storage_hub
DB_USER=postgres
DB_PASS=postgres
DB_NAME=live_storage_hub

JWT_SECRET_KEY=replace-with-at-least-32-random-characters

ADMIN_SUPER_SECRET_KEY=replace-with-a-random-admin-key

SPRING_PROFILES_ACTIVE=local

LOCAL_STORAGE_PATH=./storage

MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# Only required when storage.mode=s3 in production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
